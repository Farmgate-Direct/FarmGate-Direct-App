# ================================
# Dependencies
# ================================
node_modules/
.npm/
.yarn-integrity
.pnpm-store/

# ================================
# Env / Secrets — never commit
# (nagbabasa ako ng structure lang, hindi ng laman ng .env)
# ================================
.env
.env.*
!.env.example
*.local

# Firebase / service account secrets
serviceAccountKey.json
firebase-service-account.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Android / iOS signing & local config
*.keystore
*.jks
*.p12
*.pem
*.key
android/local.properties
android/captures/
android/.gradle/
android/.cxx/
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace
ios/*.xcuserstate

# ================================
# Build outputs
# ================================
dist/
dist-ssr/
build/
web-build/
out/
*.tgz

# Vite (client/admin)
# /dist at /dist-ssr covered above

# Expo (client/mobile) — managed cache & web output
.expo/
.expo-shared/
expo-env.d.ts
.metro-health-check*
*.jsbundle

# Firebase Functions (functions/ — TypeScript build output)
functions/lib/
lib/**/*.js
lib/**/*.js.map
typings/
*.tsbuildinfo

# Automation scripts (scripts-automation/*/dist)
scripts-automation/*/dist/

# ================================
# Firebase emulators / hosting cache
# ================================
.firebase/
.dataconnect/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*

# ================================
# Logs / coverage / runtime
# ================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/
lib-cov/
pids/
*.pid
*.seed
*.pid.lock
.node_repl_history
.eslintcache

# ================================
# OS / IDE / temp
# ================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*.orig
.tmp/
.temp/

